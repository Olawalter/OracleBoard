# GenLayer network — one of: studionet | testnet-asimov | localnet
NEXT_PUBLIC_GENLAYER_CHAIN=studionet

# Deployed OracleBoard Intelligent Contract address (populated by scripts/deploy.ts).
# Leave empty on studionet to use the built-in default (see lib/genlayer/config.ts).
NEXT_PUBLIC_ORACLEBOARD_ADDRESS=

# Optional: local dev override for the Studio RPC
# NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api

# Server-side only: deployer private key used by scripts/deploy.ts
DEPLOYER_PRIVATE_KEY=
